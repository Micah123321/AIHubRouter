[Unit]
Description=AIHubRouter Web console and automatic routing
Documentation=https://github.com/OnRightPath/AIHubRouter
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=aihub-router-web
Group=aihub-router-web
WorkingDirectory=/opt/aihub-router-web
Environment=XDG_CONFIG_HOME=/var/lib/aihub-router-web
Environment=DOTNET_NOLOGO=1
Environment=AIHUB_WEB_URLS=https://0.0.0.0:5443
Environment=Kestrel__Certificates__Default__Path=/etc/aihub-router-web/aihub-router-web.pfx
EnvironmentFile=/etc/aihub-router-web/environment
ExecStart=/opt/aihub-router-web/aihub-router-web
Restart=always
RestartSec=5s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/aihub-router-web
ReadWritePaths=/var/lib/aihub-router-web
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aihub-router-web

[Install]
WantedBy=multi-user.target

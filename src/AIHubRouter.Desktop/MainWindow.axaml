<Window
    x:Class="AIHubRouter.Desktop.MainWindow"
    x:DataType="local:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AIHubRouter.Desktop"
    Title="AIHub Router"
    Icon="/Assets/app-icon.ico"
    Closing="OnClosing"
    Width="1240"
    Height="900"
    MinWidth="980"
    MinHeight="720"
    Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="18,14">
      <Grid ColumnDefinitions="*,Auto,24,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="AIHub Router" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
          <TextBlock Text="{Binding ConnectionSummary}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding CandidateSummary}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AppSuccessBrush}" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="主题" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSecondaryBrush}" />
          <ComboBox Width="116" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedThemeChoice}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="local:ThemeChoice">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*">
        <Border Grid.Row="0" Classes="section-rule">
          <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="105,*,105,*">
            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="连接与认证" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="站点" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Classes="field" Text="{Binding BaseUrl}" Margin="0,0,14,8" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="邮箱" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="3" Classes="field" Text="{Binding Email}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="密码" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Classes="field" Text="{Binding Password}" PasswordChar="*" Margin="0,0,14,0" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Token" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="3" Classes="field" Text="{Binding BearerToken}" PasswordChar="*" />
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="section-rule">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,24,Auto,125,*">
            <TextBlock Grid.Row="0" Grid.ColumnSpan="7" Text="路由策略" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="0">
              <RadioButton Content="省钱" GroupName="mode" IsChecked="{Binding IsEconomy}" IsEnabled="{Binding CanChangeRoutingMode}" Padding="14,7" />
              <RadioButton Content="均衡" GroupName="mode" IsChecked="{Binding IsBalanced}" IsEnabled="{Binding CanChangeRoutingMode}" Padding="14,7" />
              <RadioButton Content="极速" GroupName="mode" IsChecked="{Binding IsSpeed}" IsEnabled="{Binding CanChangeRoutingMode}" Padding="14,7" />
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="4" Text="间隔 秒" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="5" Minimum="30" Maximum="3600" Increment="30" Value="{Binding PollingIntervalSeconds}" />
            <CheckBox Grid.Row="1" Grid.Column="6" Content="安全保存认证" IsChecked="{Binding PersistCredentials}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="0,0,0,14">
          <Button Grid.Column="0" Classes="command" Content="保存" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
          <Button Grid.Column="1" Classes="command" Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
          <Button Grid.Column="2" Classes="command" Content="模拟" Command="{Binding DryRunCommand}" Margin="0,0,8,0" />
          <Button Grid.Column="3" Classes="command" Content="立即路由" Command="{Binding RouteCommand}" Margin="0,0,8,0" />
          <Button Grid.Column="4" Classes="command" Content="手动选择" Command="{Binding ManualRouteCommand}" Margin="0,0,8,0" />
          <ToggleButton Grid.Column="5" Classes="command" Content="自动路由" IsChecked="{Binding AutoRouting}" />
          <ProgressBar Grid.Column="6" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="140" Height="4" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="3" RowDefinitions="*,14,*" MinHeight="440">
          <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="38,*">
              <Grid Grid.Row="0" ColumnDefinitions="54,64,*,90,110,110,110,100,150" Background="{DynamicResource AppSurfaceAltBrush}">
                <TextBlock Grid.Column="0" Text="禁用" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Grid.Column="1" Classes="table-header" Content="{Binding GroupHeader}" Command="{Binding SortProvidersCommand}" CommandParameter="GroupId" Margin="10,0,0,0" />
                <Button Grid.Column="2" Classes="table-header" Content="{Binding PlanHeader}" Command="{Binding SortProvidersCommand}" CommandParameter="Plan" />
                <Button Grid.Column="3" Classes="table-header" Content="{Binding MultiplierHeader}" Command="{Binding SortProvidersCommand}" CommandParameter="Multiplier" />
                <Button Grid.Column="4" Classes="table-header" Content="{Binding LatencyHeader}" Command="{Binding SortProvidersCommand}" CommandParameter="Latency" />
                <Button Grid.Column="5" Classes="table-header" Content="{Binding SuccessRateHeader}" Command="{Binding SortProvidersCommand}" CommandParameter="SuccessRate" />
                <Button Grid.Column="6" Classes="table-header" Content="{Binding WeightedScoreHeader}" Command="{Binding SortProvidersCommand}" CommandParameter="WeightedScore" />
                <TextBlock Grid.Column="7" Text="状态" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Grid.Column="8" Text="检测时间" VerticalAlignment="Center" FontWeight="SemiBold" />
              </Grid>
              <ListBox Grid.Row="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" SelectionMode="Single" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:ProviderRowViewModel">
                    <Grid ColumnDefinitions="54,64,*,90,110,110,110,100,150" MinHeight="34">
                      <ToggleButton Grid.Column="0"
                                    Classes="blacklist-toggle"
                                    IsChecked="{Binding Blacklisted}"
                                    ToolTip.Tip="{Binding BlacklistToolTip}"
                                    AutomationProperties.Name="切换分组禁用状态"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                        <PathIcon Width="10"
                                  Height="10"
                                  Data="M 2,0 L 5,3 L 8,0 L 10,2 L 7,5 L 10,8 L 8,10 L 5,7 L 2,10 L 0,8 L 3,5 L 0,2 Z"
                                  Foreground="{Binding $parent[ToggleButton].Foreground}" />
                      </ToggleButton>
                      <TextBlock Grid.Column="1" Text="{Binding GroupId}" Margin="10,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Plan}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Multiplier}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding Latency}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="5" Text="{Binding SuccessRate}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="6" Text="{Binding WeightedScore}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="7" Text="{Binding State}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="8" Text="{Binding CheckedAt}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="38,*">
              <Grid Grid.Row="0" ColumnDefinitions="72,80,*,110,100,180" Background="{DynamicResource AppSurfaceAltBrush}">
                <TextBlock Grid.Column="0" Text="路由" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="ID" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="Key" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Grid.Column="3" Text="状态" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="分组" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Grid.Column="5" Text="分组名称" VerticalAlignment="Center" FontWeight="SemiBold" />
              </Grid>
              <ListBox Grid.Row="1" ItemsSource="{Binding Keys}" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:KeyRowViewModel">
                    <Grid ColumnDefinitions="72,80,*,110,100,180" MinHeight="34">
                      <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" Margin="10,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Id}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Status}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding GroupId}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="5" Text="{Binding GroupName}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="14,5">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="status" Classes.success="{Binding StatusIsSuccess}" Classes.error="{Binding StatusIsError}" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Button Grid.Column="1" Classes="status-command" Content="访问站点" Command="{Binding VisitSiteCommand}" />
      </Grid>
    </Border>
  </Grid>
</Window>

<Application
    x:Class="AIHubRouter.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.command">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Border.section-rule">
      <Setter Property="BorderBrush" Value="#D9DEE5" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,0,0,14" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
  </Application.Styles>
</Application>
